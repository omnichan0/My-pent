+func TestClient_CommitWorkerImage_RejectsUnsafeOrIncompleteRequests(t *testing.T) {
+	dc := &dockerClient{}
+	tests := []struct {
+		name        string
+		containerID string
+		image       string
+		comment     string
+		wantError   string
+	}{
+		{
+			name:        "official images cannot be replaced",
+			containerID: "worker-id",
+			image:       "vxcontrol/kali-linux:latest",
+			comment:     "approved tool",
+			wantError:   "refusing to replace non-local worker image",
+		},
+		{
+			name:        "reason is required",
+			containerID: "worker-id",
+			image:       "pentagi-local/kali-tools:approved",
+			wantError:   "worker image commit reason is required",
+		},
+		{
+			name:      "container ID is required",
+			image:     "pentagi-local/kali-tools:approved",
+			comment:   "approved tool",
+			wantError: "worker container ID is required",
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			err := dc.CommitWorkerImage(context.Background(), tc.containerID, tc.image, tc.comment)
+			require.ErrorContains(t, err, tc.wantError)
+		})
+	}
+}
