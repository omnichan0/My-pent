+func (dc *dockerClient) CommitWorkerImage(ctx context.Context, containerID, image, comment string) error {
+	if !strings.HasPrefix(image, "pentagi-local/kali-tools:") {
+		return fmt.Errorf("refusing to replace non-local worker image %q", image)
+	}
+	if strings.TrimSpace(comment) == "" {
+		return fmt.Errorf("worker image commit reason is required")
+	}
+	if strings.TrimSpace(containerID) == "" {
+		return fmt.Errorf("worker container ID is required")
+	}
+
+	if _, err := dc.client.ContainerCommit(ctx, containerID, client.ContainerCommitOptions{
+		Reference: image,
+		Comment:   comment,
+	}); err != nil {
+		return fmt.Errorf("failed to persist worker image %q: %w", image, err)
+	}
+
+	return nil
+}
